# Loaded by `vite build` (production). Committed on purpose: a production build must never use demo data.
# Set the two URLs in the hosting dashboard (Vercel > Settings > Environment Variables); values there win.
VITE_USE_MOCK=false

# Public URL of the API, including the /api prefix, e.g. https://api.digrow.rw/api
# VITE_API_URL=https://your-backend-host/api

# Socket.io server for admin real-time notifications (the API host without /api), e.g. https://api.digrow.rw
# VITE_SOCKET_URL=https://your-backend-host
