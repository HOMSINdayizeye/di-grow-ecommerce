# Base URL of the backend API. Leave as /api to use the Vite dev proxy.
VITE_API_URL=/api

# Socket.io server URL for the admin real-time notifications.
VITE_SOCKET_URL=http://localhost:5000

# Use in-memory mock data instead of the API (handy while the backend is not ready).
VITE_USE_MOCK=true

# Public site URL, used for canonical links and structured data.
VITE_SITE_URL=https://digrow.rw

# Business contact details shown on the site.
VITE_WHATSAPP_NUMBER=250788000000
VITE_PHONE_NUMBER=+250 788 000 000
VITE_CONTACT_EMAIL=hello@digrow.rw
VITE_ADDRESS=KN 4 Ave, Nyarugenge, Kigali
