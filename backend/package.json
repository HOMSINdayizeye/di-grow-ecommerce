{
  "name": "@di-grow/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Di-Grow API: Express + MongoDB + Socket.io backend for the storefront and admin dashboard.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "build": "node -e \"console.log('Di-Grow API has no build step; nothing to do.')\"",
    "seed": "node --env-file-if-exists=.env src/seed/seed.js",
    "seed:demo": "node --env-file-if-exists=.env src/seed/seed.js --demo",
    "seed:reset": "node --env-file-if-exists=.env src/seed/seed.js --reset --demo"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^6.9.16",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  }
}
