# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/digrow

# JWT secret for admin sessions (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d

# Comma separated origins allowed to call the API (the Vite dev server and the public site)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost

# Public URL of the storefront, used in password reset links and the sitemap
FRONTEND_URL=http://localhost:5173

# Where uploaded images are served from. Relative paths work behind the Vite proxy and nginx.
UPLOADS_BASE_URL=/api/uploads

# First admin account created by `npm run seed`
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@digrow.rw
ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# Email (password reset links, new-order alerts). Leave everything empty to
# print emails to the console instead of sending them.
#
# Option A: Brevo (https://app.brevo.com). Add and confirm a sender under
# "Senders, Domains & Dedicated IPs > Senders", then either:
#   - paste an API key (starts with "xkeysib-", from SMTP & API > API Keys), or
#   - paste an SMTP key (starts with "xsmtpsib-", from SMTP & API > SMTP) AND set
#     SMTP_USER to the "Login" shown on that same page (looks like 8a1b2c001@smtp-brevo.com;
#     on older accounts it is the account email).
BREVO_API_KEY=
BREVO_EMAIL_SENDER=no-reply@digrow.rw
BREVO_EMAIL_SENDER_NAME=Di-Grow
SMTP_USER=

# Option B: any other SMTP server (Gmail app password, Mailgun, your host...).
SMTP_HOST=
SMTP_PORT=587
SMTP_PASS=
SMTP_FROM="Di-Grow <no-reply@digrow.rw>"
# ---------------------------------------------------------------------------
